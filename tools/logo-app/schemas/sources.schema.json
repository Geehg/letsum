{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LETSUM public source evidence 1.0",
  "type": "object",
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\\\\\u0000-\\u0020\\u007F-\\u009F]+(?:[/?#][^\\\\\\u0000-\\u0020\\u007F-\\u009F]*)?$"
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "enum": [
              "page",
              "search"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "language",
          "checked_at",
          "scope",
          "observation",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "updated_at",
    "sources"
  ],
  "additionalProperties": false
}
