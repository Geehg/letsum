{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LETSUM local review patch 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "base_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "changes": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "name_en": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "category": {
                "type": "string",
                "enum": [
                  "national-government",
                  "local-government",
                  "public-organization",
                  "education",
                  "business",
                  "nonprofit",
                  "intergovernmental"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "organization",
                  "city-brand",
                  "product",
                  "service",
                  "campaign",
                  "anniversary",
                  "mascot",
                  "character"
                ]
              },
              "sectors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "administration",
                    "education",
                    "research-science",
                    "healthcare",
                    "welfare",
                    "culture-arts",
                    "tourism",
                    "sports",
                    "environment",
                    "transport-logistics",
                    "energy",
                    "finance",
                    "ict-digital",
                    "industry-manufacturing",
                    "agriculture-food",
                    "housing-construction",
                    "safety-defense",
                    "international-cooperation"
                  ]
                },
                "uniqueItems": true
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z]{2}$"
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\\\\\u0000-\\u0020\\u007F-\\u009F]+(?:[/?#][^\\\\\\u0000-\\u0020\\u007F-\\u009F]*)?$"
              },
              "guideline_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/?#@\\\\\\u0000-\\u0020\\u007F-\\u009F]+(?:[/?#][^\\\\\\u0000-\\u0020\\u007F-\\u009F]*)?$"
              },
              "usage": {
                "type": "object",
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "summary"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "review_note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "changes",
          "review_note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "base_sha256",
    "created_at",
    "patches"
  ],
  "additionalProperties": false
}
