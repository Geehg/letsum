    "mc-q15623329": {
      "name": "코레일네트웍스 캐릭터",
      "reason": "코레일네트웍스 명의로 수집한 경기도청 페이지와 섬네일은 경기도 고유 캐릭터 봉공이이다.",
      "source": "https://www.gg.go.kr/contents/contents.do?ciIdx=1509&menuId=3423"
