    },
    "mc-q12623100": {
      "name": "모두의 풍속도",
      "reason": "모두의 풍속도는 참가자가 조선시대 캐릭터를 만드는 궁중문화축전 온라인 참여 프로그램명이다.",
      "source": "https://www.kh.or.kr/brd/board/715/L/menu/373?bbIdx=119831&brdType=R"
    },
    "mc-q12623804": {
      "name": "한국특허정보원 캐릭터",
      "reason": "기관 로고 안내의 “칼라 캐릭터” 이미지를 직접 확인했다. 도판은 빨간색과 노란색의 CI 띠 그래픽이다.",
      "source": "https://www.kipi.or.kr/EgovPageLink.do?link=/main/sub01/sub0104"
    },
    "mc-q12623900": {
      "name": "한국환경산업기술원 캐릭터",
      "reason": "공식 페이지가 제시하는 대상은 KEITI 영문 심벌마크와 색상이다. 본문의 캐릭터라는 단어는 보조색이 높여 주는 기관의 시각적 성격을 뜻한다.",
      "source": "https://www.keiti.re.kr/site/keiti/01/10105010000002018102909.jsp"
    },
    "mc-q140800179": {
      "name": "공소청 캐릭터",
      "reason": "공소청 명의로 수집한 법제처 공식 페이지와 섬네일은 법제처 고유 캐릭터 새령이이다. 법제처 항목이 별도로 존재한다.",
      "source": "https://www.moleg.go.kr/menu.es?mid=a10701040000#tab_2"
